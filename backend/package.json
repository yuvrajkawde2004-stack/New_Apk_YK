{
  "name": "retailflow-backend",
  "version": "1.0.0",
  "description": "Cloudflare Worker Backend for RetailFlow",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute retailflow-d1 --local --file=./schema.sql",
    "db:deploy": "wrangler d1 execute retailflow-d1 --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "typescript": "^5.0.4",
    "wrangler": "^3.0.0"
  }
}
